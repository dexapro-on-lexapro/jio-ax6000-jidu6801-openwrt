#!/bin/sh /etc/rc.common
START=95
STOP=10

boot() {
    start
}

start() {
    if [ -x /mnt/start-openwrt.sh ]; then
        /mnt/start-openwrt.sh
    fi
}

stop() {
    pkill -f "/mnt/usr/bin/AdGuardHome" 2>/dev/null || true
    pkill -f "/mnt/usr/sbin/nlbwmon" 2>/dev/null || true
    pkill -f "/mnt.*dropbear.*2222" 2>/dev/null || true
    pkill -f "/mnt.*uhttpd" 2>/dev/null || true
    pkill -f "/mnt/sbin/rpcd" 2>/dev/null || true
}
